# Origins allowed to call the API from a browser (comma-separated).
ALLOWED_ORIGINS=https://charlesw25.github.io

# Letterboxd profile to pull the RSS feed from. Leave blank to disable.
LETTERBOXD_USERNAME=

# How often the sync container runs a pass.
SYNC_INTERVAL_HOURS=6

# How many raw payloads to keep per source under data/raw/.
RAW_KEEP_PER_SOURCE=20
